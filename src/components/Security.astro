---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const arsenalGroups = [
	{
		icon: "fa-solid fa-crosshairs",
		title: t("security.catOfensivaTitulo"),
		items: [
			t("security.catOfensiva1"),
			t("security.catOfensiva2"),
			t("security.catOfensiva3"),
			t("security.catOfensiva4"),
			t("security.catOfensiva5"),
			"MITRE ATT&CK",
			"DevSecOps",
		],
	},
	{
		icon: "fa-solid fa-toolbox",
		title: t("security.catHerramientasTitulo"),
		items: ["Suricata", "Caido", "Wireshark", "Autopsy"],
	},
	{
		icon: "fa-solid fa-shield-halved",
		title: t("security.catDefensivaTitulo"),
		items: [
			t("security.catDefensiva1"),
			t("security.catDefensiva2"),
			t("security.catDefensiva3"),
			"OWASP",
			t("security.catDefensiva4"),
			"ISO 27001",
		],
	},
	{
		icon: "fa-solid fa-network-wired",
		title: t("security.catRedesTitulo"),
		items: [
			t("security.catRedes1"),
			"VPN",
			t("security.catRedes2"),
			"pfSense",
			"PKI",
			"WSUS",
		],
	},
];

const writeups = [
	{
		href: "https://github.com/devSammyO/writeups/tree/main/thehackerslabs/pa-que-aiga-lujo",
		sourceIcon: "fa-brands fa-github",
		sourceLabel: t("security.writeup1Plataforma"),
		titulo: t("security.writeup1Titulo"),
		desc: t("security.writeup1Desc"),
		image: "/images/writeups/pa-que-aiga-lujo.png",
		tags: ["Nmap", "Hydra", "Metasploit", "Ligolo-ng"],
	},
	{
		href: "/writeups/vpn-wireguard-mikrotik.pdf",
		sourceIcon: "fa-solid fa-file-pdf",
		sourceLabel: t("security.writeup3Plataforma"),
		titulo: t("security.writeup3Titulo"),
		desc: t("security.writeup3Desc"),
		image: "/images/writeups/vpn-wireguard-mikrotik.png",
		tags: ["WireGuard", "MikroTik", "VLAN", "GNS3"],
	},
	{
		href: "/writeups/proxy-transparente-squid-wazuh.pdf",
		sourceIcon: "fa-solid fa-file-pdf",
		sourceLabel: t("security.writeup2Plataforma"),
		titulo: t("security.writeup2Titulo"),
		desc: t("security.writeup2Desc"),
		image: "/images/writeups/proxy-squid-wazuh.png",
		tags: ["Squid", "MikroTik", "iptables", "Wazuh"],
	},
	{
		href: "/writeups/sqlmap-thm-blind-sqli.pdf",
		sourceIcon: "fa-solid fa-file-pdf",
		sourceLabel: t("security.writeup4Plataforma"),
		titulo: t("security.writeup4Titulo"),
		desc: t("security.writeup4Desc"),
		image: "/images/writeups/sqlmap-thm.png",
		tags: ["SQLMap", "Nmap", "MySQL", "GTFOBins"],
	},
	{
		href: "/writeups/idor-path-traversal.pdf",
		sourceIcon: "fa-solid fa-file-pdf",
		sourceLabel: t("security.writeup5Plataforma"),
		titulo: t("security.writeup5Titulo"),
		desc: t("security.writeup5Desc"),
		image: "/images/writeups/idor-path-traversal.png",
		tags: ["IDOR", "Path Traversal", "Burp Suite"],
	},
];

const platforms = [
	{
		name: "Hack The Box",
		icon: "fa-solid fa-cubes",
		href: "https://profile.hackthebox.com/profile/01a094c9-3d37-72f8-af01-5f07116b7e96",
		stat: t("security.htbStat"),
	},
	{
		name: "TryHackMe",
		icon: "fa-solid fa-flag-checkered",
		href: "https://tryhackme.com/p/sampojohn365",
		stat: t("security.thmStat"),
	},
];
---

<section class="section-pad section-alt seguridad-section" id="seguridad">
	<div class="seguridad-seccion section-container">
		<div class="seguridad-titulos section-head reveal">
			<span class="section-head-index" aria-hidden="true">02</span>
			<div class="section-head-main">
				<span class="section-tag">
					<span class="section-tag-path">~/seguridad</span>
					<span class="section-tag-dot" aria-hidden="true"></span>
					{t("security.eyebrow")}
				</span>
				<h2 class="section-title" data-scramble>{t("security.titulo")}</h2>
			</div>
			<p class="section-head-desc">{t("security.subtitulo")}</p>
		</div>

		<div class="arsenal term-window reveal">
			<div class="term-bar">
				<span class="term-dot term-dot-red"></span>
				<span class="term-dot term-dot-yellow"></span>
				<span class="term-dot term-dot-green"></span>
				<span class="term-bar-title">security@sammy: ~/arsenal</span>
			</div>
			<div class="arsenal-body skills-matrix">
				{
					arsenalGroups.map((group) => (
						<details class="skills-panel">
							<summary class="skills-panel-head">
								<span class="skills-panel-icon">
									<i class={group.icon} />
								</span>
								<h6>{group.title}</h6>
								<span class="skills-panel-count">{group.items.length}</span>
								<i
									class="fa-solid fa-chevron-down skills-panel-caret"
									aria-hidden="true"
								/>
							</summary>
							<div class="skills">
								{group.items.map((item) => (
									<span class="skill-pill">{item}</span>
								))}
							</div>
						</details>
					))
				}
			</div>
		</div>

		<div class="plataformas-bloque reveal">
			<h5 class="term-label">
				<span class="term-label-prompt">$</span>
				<span class="term-label-cmd">ls</span>
				<span class="term-label-path">~/plataformas</span>
				<span class="term-label-cursor" aria-hidden="true"></span>
			</h5>
			<div class="plataformas-grid">
				{
					platforms.map((p) => (
						<a
							class="plataforma-card"
							href={p.href}
							target="_blank"
							rel="noopener noreferrer"
							data-spotlight
						>
							<span class="btn-spotlight" aria-hidden="true"></span>
							<span class="plataforma-icono">
								<i class={p.icon} />
							</span>
							<div class="plataforma-info">
								<h6>{p.name}</h6>
								<p>{p.stat}</p>
							</div>
							<i
								class="fa-solid fa-arrow-up-right-from-square plataforma-arrow"
								aria-hidden="true"
							/>
						</a>
					))
				}
			</div>
		</div>

		<div class="writeups-bloque reveal">
			<h5 class="term-label">
				<span class="term-label-prompt">$</span>
				<span class="term-label-cmd">ls</span>
				<span class="term-label-path">~/writeups</span>
				<span class="term-label-cursor" aria-hidden="true"></span>
			</h5>
			<div class="writeups-grid">
				{
					writeups.map((w) => (
						<a
							class="writeup-card"
							href={w.href}
							target="_blank"
							rel="noopener noreferrer"
							data-spotlight
						>
							<span class="btn-spotlight" aria-hidden="true" />
							<div class="writeup-media">
								<img
									class="writeup-imagen"
									src={w.image}
									alt={w.titulo}
									loading="lazy"
									onerror="this.remove()"
								/>
								<span class="writeup-tags-float">
									{w.tags.map((tag) => (
										<span class="tag-float">{tag}</span>
									))}
								</span>
								<span class="writeup-scrim" aria-hidden="true" />
								<div class="writeup-overlay-info">
									<span class="writeup-fuente">
										<i class={w.sourceIcon} />
										{w.sourceLabel}
									</span>
									<h3>{w.titulo}</h3>
								</div>
							</div>
							<div class="writeup-footer">
								<p>{w.desc}</p>
								<span class="writeup-link-inline">
									{t("security.leerWriteup")}
									<i
										class="fa-solid fa-arrow-up-right-from-square"
										aria-hidden="true"
									/>
								</span>
							</div>
						</a>
					))
				}
			</div>
			<a
				class="mas-writeups btn btn-ghost btn-sm"
				href="https://github.com/devSammyO/writeups"
				target="_blank"
				rel="noopener noreferrer"
				data-spotlight
			>
				<span class="btn-spotlight" aria-hidden="true"></span>
				<span class="btn-content">
					{t("security.masWriteups")}
					<i
						class="fa-solid fa-arrow-up-right-from-square btn-icon"
						aria-hidden="true"
					/>
				</span>
			</a>
		</div>
	</div>
</section>

<style>
	.seguridad-section {
		position: relative;
		overflow: hidden;
	}

	.seguridad-section::before {
		content: "";
		position: absolute;
		inset: 0;
		background-image: linear-gradient(
				rgba(26, 188, 156, 0.07) 1px,
				transparent 1px
			),
			linear-gradient(90deg, rgba(26, 188, 156, 0.07) 1px, transparent 1px);
		background-size: 44px 44px;
		mask-image: radial-gradient(circle at 50% 0%, black, transparent 70%);
		-webkit-mask-image: radial-gradient(
			circle at 50% 0%,
			black,
			transparent 70%
		);
		pointer-events: none;
	}

	.seguridad-seccion {
		position: relative;
		z-index: 1;
	}

	/* ===== Arsenal (skills) ===== */
	.arsenal {
		width: 100%;
	}

	.arsenal-body {
		padding: 24px;
	}

	/* ===== Plataformas ===== */
	.plataformas-bloque {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
		width: 100%;
	}


	.plataformas-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 16px;
		width: 100%;
		max-width: 560px;
	}

	.plataforma-card {
		position: relative;
		display: flex;
		align-items: center;
		gap: 18px;
		padding: 20px 22px;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: 16px;
		box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.35);
		text-align: left;
		overflow: hidden;
		transition: transform 0.3s ease, box-shadow 0.3s ease,
			border-color 0.3s ease;
	}

	.plataforma-card .btn-spotlight {
		background: radial-gradient(
			200px circle at var(--x, 50%) var(--y, 50%),
			var(--accent-soft),
			transparent 70%
		);
	}

	.plataforma-card::before {
		content: "";
		position: absolute;
		top: -40px;
		right: -40px;
		width: 120px;
		height: 120px;
		background: radial-gradient(
			circle,
			rgba(26, 188, 156, 0.16),
			transparent 70%
		);
		pointer-events: none;
	}

	.plataforma-card:hover {
		transform: translateY(-4px);
		border-color: var(--accent);
		box-shadow: 0px 16px 32px rgba(0, 0, 0, 0.5);
	}

	.plataforma-icono {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 50px;
		height: 50px;
		flex-shrink: 0;
		border-radius: 14px;
		background: var(--accent-soft);
		color: var(--accent);
		font-size: 22px;
	}

	.plataforma-info {
		position: relative;
		z-index: 1;
		flex: 1;
		min-width: 0;
	}

	.plataforma-info h6 {
		margin: 0;
		color: var(--text);
		font-size: 15px;
	}

	.plataforma-info p {
		margin: 4px 0 0;
		color: var(--text-dim);
		font-family: var(--font-mono);
		font-size: 12px;
	}

	.plataforma-arrow {
		position: relative;
		z-index: 1;
		color: var(--text-dim);
		font-size: 14px;
		transition: color 0.25s ease, transform 0.25s ease;
	}

	.plataforma-card:hover .plataforma-arrow {
		color: var(--accent);
		transform: translate(2px, -2px);
	}

	/* ===== Writeups ===== */
	.writeups-bloque {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 24px;
		width: 100%;
	}


	.writeups-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 24px;
		width: 100%;
	}

	.writeup-card {
		position: relative;
		display: flex;
		flex-direction: column;
		text-align: left;
		background: var(--bg-elevated);
		border-radius: 16px;
		overflow: hidden;
		border: 1px solid var(--border);
		box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.35);
		transition: transform 0.3s ease, box-shadow 0.3s ease,
			border-color 0.3s ease;
	}

	.writeup-card .btn-spotlight {
		background: radial-gradient(
			220px circle at var(--x, 50%) var(--y, 50%),
			var(--accent-soft),
			transparent 70%
		);
	}

	.writeup-card:hover {
		transform: translateY(-6px);
		border-color: var(--accent);
		box-shadow: 0px 16px 40px rgba(0, 0, 0, 0.5);
	}

	.writeup-media {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: repeating-linear-gradient(
				135deg,
				rgba(26, 188, 156, 0.08) 0px,
				rgba(26, 188, 156, 0.08) 2px,
				transparent 2px,
				transparent 14px
			),
			var(--bg-elevated);
	}

	.writeup-imagen {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.writeup-card:hover .writeup-imagen {
		transform: scale(1.06);
	}

	.writeup-scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to top,
			rgba(10, 14, 17, 0.92) 0%,
			rgba(10, 14, 17, 0.5) 40%,
			transparent 68%
		);
		pointer-events: none;
	}

	.writeup-tags-float {
		position: absolute;
		z-index: 2;
		top: 14px;
		left: 14px;
		right: 14px;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		pointer-events: none;
	}

	.tag-float {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.02em;
		color: var(--accent);
		background: rgba(10, 14, 17, 0.65);
		border: 1px solid rgba(26, 188, 156, 0.4);
		padding: 5px 10px;
		border-radius: 999px;
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.35);
		animation: tagFloat 3.6s ease-in-out infinite;
	}

	.tag-float:nth-child(2) {
		animation-delay: 0.3s;
	}
	.tag-float:nth-child(3) {
		animation-delay: 0.6s;
	}
	.tag-float:nth-child(4) {
		animation-delay: 0.9s;
	}

	@keyframes tagFloat {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-4px);
		}
	}

	.writeup-overlay-info {
		position: absolute;
		z-index: 2;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 18px 20px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.writeup-fuente {
		display: flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-mono);
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--accent);
	}

	.writeup-overlay-info h3 {
		margin: 0;
		color: #fff;
		font-size: 17px;
	}

	.writeup-footer {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 18px 20px 20px;
	}

	.writeup-footer p {
		margin: 0;
		color: var(--text-muted);
		font-size: 13px;
		line-height: 1.6;
	}

	.writeup-link-inline {
		align-self: flex-start;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--text);
		border: 1px solid var(--border);
		padding: 8px 14px;
		border-radius: 999px;
		transition: border-color 0.25s ease, color 0.25s ease;
	}

	.writeup-card:hover .writeup-link-inline {
		border-color: var(--accent);
		color: var(--accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.tag-float {
			animation: none;
		}
	}

	@media screen and (min-width: 700px) {
		.plataformas-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media screen and (min-width: 988px) {
		.writeups-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media screen and (min-width: 1280px) {
		.writeups-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
