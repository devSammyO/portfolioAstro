---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pentestingSkills = [
	"Nmap",
	"Burp Suite",
	"Metasploit",
	"Wireshark",
	"Hydra",
	"Gobuster",
	"Ligolo-ng",
	"Kali Linux",
];

const hardeningSkills = [
	"Wazuh",
	"Suricata",
	"pfSense",
	"Squid",
	"VLANs",
	"DMZ",
	"iptables",
	"CIS Benchmarks",
];

const platforms = [
	{
		name: "Hack The Box",
		icon: "fa-solid fa-cubes",
		href: "https://profile.hackthebox.com/profile/01a094c9-3d37-72f8-af01-5f07116b7e96",
		stat: t("security.htbStat"),
	},
	{
		name: "TryHackMe",
		icon: "fa-solid fa-flag-checkered",
		href: "https://tryhackme.com/p/sampojohn365",
		stat: t("security.thmStat"),
	},
];
---

<section class="section-pad section-alt" id="seguridad">
	<div class="seguridad-seccion section-container">
		<div class="seguridad-titulos reveal">
			<h5>{t("security.eyebrow")}</h5>
			<h2 class="section-title">{t("security.titulo")}</h2>
			<p class="seguridad-subtitulo">{t("security.subtitulo")}</p>
		</div>

		<div class="skills-columnas reveal">
			<div class="skills-columna">
				<h6>{t("security.pentestingTitulo")}</h6>
				<div class="skills">
					{
						pentestingSkills.map((skill) => (
							<span class="skill-pill">{skill}</span>
						))
					}
				</div>
			</div>
			<div class="skills-columna">
				<h6>{t("security.hardeningTitulo")}</h6>
				<div class="skills">
					{
						hardeningSkills.map((skill) => (
							<span class="skill-pill">{skill}</span>
						))
					}
				</div>
			</div>
		</div>

		<div class="plataformas-bloque reveal">
			<h5>{t("security.plataformasTitulo")}</h5>
			<div class="plataformas-grid">
				{
					platforms.map((p) => (
						<a
							class="plataforma-card"
							href={p.href}
							target="_blank"
							rel="noopener noreferrer"
						>
							<i class={p.icon}></i>
							<div>
								<h6>{p.name}</h6>
								<p>{p.stat}</p>
							</div>
						</a>
					))
				}
			</div>
		</div>

		<div class="writeups-bloque reveal">
			<h5>{t("security.writeupsTitulo")}</h5>
			<div class="writeups-grid">
				<a
					class="writeup-card"
					href="https://github.com/devSammyO/writeups/tree/main/thehackerslabs/pa-que-aiga-lujo"
					target="_blank"
					rel="noopener noreferrer"
				>
					<div class="writeup-header">
						<i class="fa-brands fa-github"></i>
						<span class="writeup-plataforma"
							>{t("security.writeup1Plataforma")}</span
						>
					</div>
					<h3>{t("security.writeup1Titulo")}</h3>
					<p>{t("security.writeup1Desc")}</p>
					<div class="writeup-tags">
						<span class="tech-tag">Nmap</span>
						<span class="tech-tag">Hydra</span>
						<span class="tech-tag">Metasploit</span>
						<span class="tech-tag">Ligolo-ng</span>
					</div>
					<span class="writeup-link">{t("security.leerWriteup")} ↗</span>
				</a>
				<a
					class="writeup-card"
					href="/writeups/proxy-transparente-squid-wazuh.pdf"
					target="_blank"
					rel="noopener noreferrer"
				>
					<div class="writeup-header">
						<i class="fa-solid fa-file-pdf"></i>
						<span class="writeup-plataforma"
							>{t("security.writeup2Plataforma")}</span
						>
					</div>
					<h3>{t("security.writeup2Titulo")}</h3>
					<p>{t("security.writeup2Desc")}</p>
					<div class="writeup-tags">
						<span class="tech-tag">Squid</span>
						<span class="tech-tag">Mikrotik</span>
						<span class="tech-tag">iptables</span>
						<span class="tech-tag">Wazuh</span>
					</div>
					<span class="writeup-link">{t("security.leerWriteup")} ↗</span>
				</a>
			</div>
			<a
				class="mas-writeups"
				href="https://github.com/devSammyO/writeups"
				target="_blank"
				rel="noopener noreferrer"
			>
				{t("security.masWriteups")} ↗
			</a>
		</div>
	</div>
</section>

<style>
	.seguridad-titulos {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.seguridad-titulos h5 {
		color: var(--text-muted);
	}

	.seguridad-subtitulo {
		color: var(--text-muted);
		max-width: 600px;
	}

	/* ===== Skills ===== */
	.skills-columnas {
		display: flex;
		flex-direction: column;
		gap: 30px;
		width: 100%;
	}

	.skills-columna {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
	}

	.skills-columna h6 {
		color: var(--text);
		font-size: 15px;
	}

	/* ===== Plataformas ===== */
	.plataformas-bloque {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
		width: 100%;
	}

	.plataformas-bloque h5 {
		color: var(--text-muted);
	}

	.plataformas-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 16px;
		width: 100%;
		max-width: 480px;
	}

	.plataforma-card {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 18px 20px;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: 14px;
		box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.35);
		text-align: left;
		transition: transform 0.3s ease, box-shadow 0.3s ease,
			border-color 0.3s ease;
	}

	.plataforma-card:hover {
		transform: translateY(-4px);
		border-color: var(--accent);
		box-shadow: 0px 16px 32px rgba(0, 0, 0, 0.5);
	}

	.plataforma-card i {
		font-size: 26px;
		color: var(--accent);
		flex-shrink: 0;
		width: 30px;
		text-align: center;
	}

	.plataforma-card h6 {
		margin: 0;
		color: var(--text);
		font-size: 15px;
	}

	.plataforma-card p {
		margin: 0;
		color: var(--text-muted);
		font-size: 13px;
	}

	/* ===== Writeups ===== */
	.writeups-bloque {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 24px;
		width: 100%;
	}

	.writeups-bloque h5 {
		color: var(--text-muted);
	}

	.writeups-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 24px;
		width: 100%;
	}

	.writeup-card {
		display: flex;
		flex-direction: column;
		gap: 14px;
		text-align: left;
		padding: 24px;
		background: var(--bg-elevated);
		border-radius: 16px;
		border: 1px solid var(--border);
		box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.35);
		transition: transform 0.3s ease, box-shadow 0.3s ease,
			border-color 0.3s ease;
	}

	.writeup-card:hover {
		transform: translateY(-6px);
		border-color: var(--accent);
		box-shadow: 0px 16px 40px rgba(0, 0, 0, 0.5);
	}

	.writeup-header {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.writeup-header i {
		font-size: 18px;
		color: var(--accent);
	}

	.writeup-plataforma {
		color: var(--text-dim);
		font-size: 13px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.writeup-card h3 {
		color: var(--text);
	}

	.writeup-card p {
		color: var(--text-muted);
		font-size: 14px;
		line-height: 1.6;
	}

	.writeup-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.tech-tag {
		background: var(--accent-soft);
		color: var(--accent);
		font-size: 12px;
		font-weight: bold;
		padding: 4px 10px;
		border-radius: 20px;
	}

	.writeup-link {
		color: var(--accent);
		font-size: 14px;
		font-weight: bold;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.mas-writeups {
		color: var(--text-muted);
		font-size: 14px;
		font-weight: 600;
		border-bottom: 1px solid var(--border-strong);
		padding-bottom: 2px;
		transition: color 0.25s ease, border-color 0.25s ease;
	}

	.mas-writeups:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	@media screen and (min-width: 700px) {
		.plataformas-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media screen and (min-width: 988px) {
		.skills-columnas {
			flex-direction: row;
			justify-content: center;
			gap: 60px;
		}

		.writeups-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
