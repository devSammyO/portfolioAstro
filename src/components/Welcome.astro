---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import Security from "./Security.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero-bg section-full" id="inicio">
	<canvas id="heroCanvas" class="hero-canvas" aria-hidden="true"></canvas>
	<div class="contenedor">
		<div>
			<img class="foto" src="/images/sammy.png" alt="Sammy Odeh" />
		</div>
		<div class="info-btn-container">
			<div class="section-info">
				<h3>{t("info.hello")}</h3>
				<h1 class="nombre">Sammy Odeh</h1>
				<h5>{t("info.webDev")}</h5>
				<p class="section-info-parrafo">
					{t("info.parrafo")}
				</p>
			</div>
			<div class="botones">
				<button class="btn-cv">{t("info.cv")}</button>
				<button class="btn-contacto">{t("nav.contact")}</button>
			</div>
		</div>
		<div class="iconos">
			<a
				href="https://github.com/devSammyO"
				target="_blank"
				rel="noopener noreferrer"
			>
				<i class="fa-brands fa-github"></i>
			</a>
			<a
				href="https://www.linkedin.com/in/sammyodeh"
				target="_blank"
				rel="noopener noreferrer"
			>
				<i class="fa-brands fa-linkedin"></i>
			</a>
		</div>
	</div>
	<a href="#sobre-mi" class="scroll-down" aria-label="Scroll down">
		<i class="fa-solid fa-chevron-down"></i>
	</a>
	<!-- Redes Sociales -->
</section>
<section class="section-pad section-alt" id="sobre-mi">
	<div class="sobre-mi-seccion section-container">
		<div class="sobre-mi-titulos reveal">
			<h5>{t("about.aprende")}</h5>
			<h2 class="section-title">{t("about.aboutMe")}</h2>
		</div>
		<div class="sobre-mi-contenedor reveal">
			<div class="sobre-mi-foto">
				<img src="/images/sammyteclado.png" alt="Sammy Odeh" />
			</div>
			<div class="sobre-mi-contenido">
				<p class="sobre-mi-parrafo">{t("about.parrafo")}</p>
				<div class="sobre-mi-highlights">
					<div class="highlight">
						<span class="material-symbols-outlined">military_tech</span>
						<div>
							<h6>1+ {t("about.años")}</h6>
							<p>{t("about.rol")}</p>
						</div>
					</div>
					<div class="highlight">
						<span class="material-symbols-outlined">school</span>
						<div>
							<h6>{t("about.daw")}</h6>
							<p>{t("about.fp")}</p>
						</div>
					</div>
					<div class="highlight">
						<span class="material-symbols-outlined">security</span>
						<div>
							<h6>{t("about.masterCyber")}</h6>
							<p>{t("about.especializacion")}</p>
						</div>
					</div>
					<div class="highlight">
						<span class="material-symbols-outlined">location_on</span>
						<div>
							<h6>{t("about.ubicacion")}</h6>
							<p>{t("about.disponibilidad")}</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
<Security />
<section class="section-pad section-alt" id="proyectos">
	<div class="proyectos-seccion section-container">
		<div class="proyectos-titulos reveal">
			<h2 class="section-title">{t("projects.proyectos")}</h2>
		</div>
		<div class="proyectos-grid reveal">
