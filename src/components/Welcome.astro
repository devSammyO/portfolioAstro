---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
	class="container-fluid d-flex justify-content-center text-center text-white bg-dark"
	id="inicio"
	style="height: 100vh;"
>
	<div class="contenedor">
		<div>
			<img class="foto" src="/images/sammy.png" />
		</div>
		<div class="info-btn-container">
			<div class="section-info">
				<h3>{t("info.hello")}</h3>
				<h1 class="nombre">Sammy Odeh</h1>
				<h5>{t("info.webDev")}</h5>
				<p class="section-info-parrafo">
					{t("info.parrafo")}
				</p>
			</div>
			<div class="botones">
				<button class="btn-cv">{t("info.cv")}</button>
				<button class="btn-contacto">{t("nav.contact")}</button>
			</div>
		</div>
		<div class="iconos">
			<a
				href="https://www.instagram.com/sr.samodeh"
				target="_blank"
				rel="noopener noreferrer"
			>
				<i class="fa-brands fa-instagram"></i>
			</a>
			<a
				href="https://www.linkedin.com/in/sammyodeh"
				target="_blank"
				rel="noopener noreferrer"
			>
				<i class="fa-brands fa-linkedin"></i>
			</a>
			<a
				href="https://github.com/devSammyO"
				target="_blank"
				rel="noopener noreferrer"
			>
				<i class="fa-brands fa-github"></i>
			</a>
		</div>
	</div>
	<!-- Redes Sociales -->
</section>
<section
	class="container-fluid d-flex justify-content-center text-center text-white"
	id="sobre-mi"
	style="height: auto; background: linear-gradient(to bottom, white, #e0dfdf);"
>
	<div class="sobre-mi-seccion">
		<div class="sobre-mi-titulos">
			<h5>{t("about.aprende")}</h5>
			<h2 class="text-black">{t("about.aboutMe")}</h2>
		</div>
		<div class="sobre-mi-contenedor">
			<div class="sobre-mi-imagen-texto">
				<img class="foto" src="/images/sammyteclado.png" />
				<p>
					{t("about.parrafo")}
				</p>
			</div>
			<div class="contenedor-sobre-mi-datos">
				<div class="sobre-mi-datos">
					<video
						autoplay
						loop
						muted
						playsinline
						class="background-video"
					>
						<source src="/videos/bgvideo.mp4" type="video/mp4" />
						Tu navegador no soporta videos.
					</video>
					<span class="material-symbols-outlined">
						military_tech
					</span>
					<h6>{t("about.exp")}</h6>
					<p>1+ {t("about.años")}</p>
					<p>{t("about.rol")}</p>
				</div>
				<div class="sobre-mi-datos">
					<video
						autoplay
						loop
						muted
						playsinline
						class="background-video"
					>
						<source src="/videos/bgvideo.mp4" type="video/mp4" />
						Tu navegador no soporta videos.
					</video>
					<span class="material-symbols-outlined"> school </span>
					<h6>{t("about.educacion")}</h6>
					<p>{t("about.bachiller")}</p>
					<p>{t("about.daw")}</p>
				</div>
			</div>
		</div>
	</div>
</section>
<section
	id="proyectos"
	class="proyectos container-fluid d-flex justify-content-center text-center"
	style="height: 100vh; background: linear-gradient(to bottom, #e0dfdf, white);"
	;
>
	<div class="proyectos-seccion">
		<div class="proyectos-titulos">
			<h2 class="text-black">{t("projects.proyectos")}</h2>
		</div>
		<div class="proyectos-contenedor">
			<div class="proyecto">
				<a
					href="https://padelges-production.up.railway.app/"
					target="_blank"
					rel="noopener noreferrer"
				>
					<h3>Padel Ges</h3>
					<img class="proyectos-img" src="/images/padelGes.png" />
				</a>
				<p>
					{t("projects.parrafo1")}
				</p>
				<div class="proyecto-skills">
					<img src="/images/laravel.png" />
				</div>
			</div>
		</div>
		<h5 class="mt-5">{t("projects.habilidades")}</h5>
		<div class="skills">
			<img src="/images/html-5.png" />
			<img src="/images/css-3.png" />
			<img src="/images/js.png" />
			<img src="/images/bootstrap.png" />
			<img src="/images/php.png" />
			<img src="/images/mysql.png" />
			<img src="/images/java.png" />
		</div>
	</div>
</section>
<section
	id="contacto"
	class="contacto container-fluid d-flex justify-content-center text-center"
	style="height: 100vh; background: linear-gradient(to bottom, white, #e0dfdf);"
	;
>
	<div class="contacto-seccion">
		<div class="contacto-titulos">
			<h2 class="text-black">{t("contacto.contacta")}</h2>
			<h5>
				{t("contacto.hablo")}
				<img src="/images/spain.png" alt="España" width="24px" />
				<img src="/images/united-kingdom.png" alt="uk" width="24px" />
			</h5>
		</div>
		<div class="contacto-redes">
			<a
				href="https://www.instagram.com/sr.samodeh"
				target="_blank"
				rel="noopener noreferrer"
			>
				<i class="fa-brands fa-instagram"></i>
				{t("contacto.insta")}
			</a>

			<a
				href="https://www.linkedin.com/in/sammyodeh"
				target="_blank"
				rel="noopener noreferrer"
			>
				<i class="fa-brands fa-linkedin"></i>{t("contacto.linkedin")}
			</a>
		</div>
		<div class="contacto-mail">
			<h5>{t("contacto.correo")}</h5>
			<form
				action="mailto:sam_po13@hotmail.com"
				method="POST"
				enctype="text/plain"
			>
				<div class="contacto-mail-contenedor">
					<div class="contacto-input-contenedor">
						<div class="flex">
							<label for="nombre">{t("contacto.tuNombre")}</label>
							<input type="text" name="nombre" required />
						</div>
						<div class="flex">
							<label for="correo">{t("contacto.tuCorreo")}</label>
							<input type="email" name="correo" required />
						</div>
					</div>
					<div class="flex">
						<label for="mensaje">{t("contacto.tuMensaje")}</label>
						<textarea name="mensaje" required></textarea>
					</div>
				</div>
				<button type="submit">{t("contacto.enviar")}</button>
			</form>
		</div>
	</div>
</section>

<style>
	@import url("https://fonts.googleapis.com/css2?family=Changa:wght@200..800&display=swap");
	@import url("https://fonts.googleapis.com/css2?family=Wendy+One&display=swap");

	.material-symbols-outlined {
		color: black;
		font-size: 30px;
	}

	body {
		font-family: "Wendy One", serif;
	}

	a {
		text-decoration: none;
		color: inherit;
	}

	.contenedor {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 30px;
		margin-top: 0;
		text-align: center;
	}

	.foto {
		width: 150px;
		border-radius: 200px;
		/* animation: bombillaFundida 3s infinite steps(1); */
	}

	@keyframes bombillaFundida {
		0% {
			filter: brightness(1.5);
		}
		10% {
			filter: brightness(0.3);
		}
		20% {
			filter: brightness(1.2);
		}
		30% {
			filter: brightness(0.6);
		}
		40% {
			filter: brightness(1.8);
		}
		50% {
			filter: brightness(0.1);
		}
		60% {
			filter: brightness(1.5);
		}
		70% {
			filter: brightness(0.4);
		}
		80% {
			filter: brightness(1.7);
		}
		90% {
			filter: brightness(0.2);
		}
		100% {
			filter: brightness(1.5);
		}
	}

	.section-info {
		margin-top: 60px;
	}

	.nombre {
		color: #1abc9c;
	}

	.section-info * {
		margin-top: 10px;
	}

	.section-info h5 {
		font-family: "Changa", serif;
	}

	.section-info-parrafo {
		display: none;
	}

	.botones {
		display: flex;
		justify-content: center;
		flex-direction: column;
		gap: 10px;
	}

	/* Estilos generales de los botones */
	.btn-contacto,
	.btn-cv {
		padding: 12px 24px;
		min-width: 180px;
		font-size: 16px;
		font-weight: bold;
		border-radius: 5px;
		cursor: pointer;
		transition: all 0.3s ease-in-out;
		text-transform: uppercase;
		box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
		margin-top: 10px;
	}

	/* Botón Contacto */
	.btn-contacto {
		background-color: #1abc9c;
		color: black;
		border: 2px solid #1abc9c;
		transition: all 0.3s ease-in-out;
	}

	.btn-contacto:focus,
	.btn-cv:focus {
		outline: 2px solid #1abc9c;
		outline-offset: 3px;
	}

	.btn-contacto:hover {
		background-color: transparent;
		color: #1abc9c;
		transform: translateY(-2px);
		box-shadow: 0 0 12px rgba(26, 188, 156, 0.4);
	}

	/* Botón Descargar CV */
	.btn-cv {
		color: #1abc9c;
		background-color: transparent;
		border: 2px solid #1abc9c;
	}

	/* Hover Estandarizado */
	.btn-cv:hover {
		background-color: #16a085;
		color: black;
		transform: translateY(-2px);
		box-shadow: 0px 8px 15px rgba(0, 0, 0, 0.15);
	}

	/* Efecto al hacer clic */
	.btn-contacto:active,
	.btn-cv:active {
		transform: scale(0.98);
	}

	.iconos {
		position: fixed;
		right: 25px;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		flex-direction: column;
		gap: 20px;
		font-size: 30px;
		z-index: 1000;
	}

	.iconos a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.6);
		color: white;
		font-size: 20px;
		transition: all 0.3s ease;
	}

	.iconos a:hover {
		color: #1abc9c;
		transform: scale(1.15);
	}

	.sobre-mi-titulos {
		margin-top: 50px;
	}

	.sobre-mi-titulos h2 {
		font-size: 40px;
	}

	.sobre-mi-titulos h5 {
		color: #757272;
		font-family: "Changa", serif;
	}

	.sobre-mi-imagen-texto {
		display: flex;
		font-size: 12px;
		color: #757272;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		gap: 10px;
	}

	.sobre-mi-imagen-texto img {
		width: 150px;
	}

	.contenedor-sobre-mi-datos {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 20px;
	}

	.sobre-mi-datos {
		position: relative;
		overflow: hidden;
		padding: 30px;
		border-radius: 20px;
		background: rgba(0, 0, 0, 0.75);
		backdrop-filter: blur(10px);
		color: white;
		transition: transform 0.3s ease;
	}

	.sobre-mi-datos:hover {
		transform: translateY(-8px);
	}

	.background-video {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover; /* Asegura que el video cubra todo el espacio */
	}

	.sobre-mi-datos span,
	.sobre-mi-datos h6,
	.sobre-mi-datos p {
		position: relative;
		z-index: 1; /* Asegura que el texto esté sobre el video */
		color: white; /* Ajusta según el fondo del video */
		text-align: center;
		text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.5); /* Mejora la legibilidad */
	}

	.sobre-mi-datos span {
		margin-top: 10px;
	}

	.sobre-mi-datos h6 {
		margin-bottom: 15px;
	}

	.sobre-mi-datos p {
		color: #757272;
		font-size: 14px;
	}

	.sobre-mi-datos p:last-of-type {
		margin-top: -15px;
	}

	.proyectos-seccion {
		display: flex;
		flex-direction: column;
	}

	.proyectos-titulos {
		margin-top: 100px;
	}

	.proyectos-titulos h2 {
		font-size: 40px;
	}

	.proyectos-contenedor {
		margin-top: 20px;
		border: 2px solid #757272;
		border-radius: 25px;
		padding: 10px;
	}

	.proyectos-img {
		width: 200px;
	}

	.proyecto h3 {
		margin-top: 20px;
		font-family: "Changa", serif;
	}

	.proyecto p {
		color: #757272;
	}

	.proyecto-skills img {
		width: 100px;
	}

	.skills {
		margin-top: 20px;
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		justify-content: center;
	}

	.skills img {
		width: 50px;
		margin: 0 10px;
	}

	.contacto-seccion {
		width: 90%;
	}

	.contacto-titulos {
		margin-top: 100px;
	}

	.contacto-titulos h2 {
		font-size: 30px;
	}

	.contacto-titulos h5 {
		color: #757272;
	}

	.contacto-redes {
		display: flex;
		flex-direction: column;
		margin-top: 50px;
		align-items: flex-start;
		gap: 10px;
	}

	.contacto-redes a {
		margin-left: 10px;
		display: flex;
		align-items: center;
	}
	.contacto-redes i {
		margin-right: 10px;
		font-size: 30px;
	}

	.contacto-mail {
		margin-top: 50px;
		gap: 10px;
		display: flex;
		flex-direction: column;
		text-align: justify;
	}

	.flex {
		display: flex;
		flex-direction: column;
		align-items: start;
		width: 100%;
	}

	.contacto-mail-contenedor {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.contacto-input-contenedor {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.contacto-mail input,
	.contacto-mail textarea {
		width: 100%;
		line-height: inherit;
	}

	button {
		width: 100%;
		margin-top: 20px;
		color: black;
		background-color: #1abc9c;
		border-radius: 5px;
		transition: all 0.3s ease-in-out;
		box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
	}

	button:hover {
		background-color: #16a085;
		transform: scale(1.05);
	}

	@media screen and (min-width: 988px) {
		.contenedor {
			flex-direction: row-reverse;
			align-items: center;
			justify-content: center;
			gap: clamp(40px, 6vw, 100px);
			min-height: 80vh;
		}
		.section-info {
			text-align: justify;
		}

		.section-info-parrafo {
			display: block;
			text-align: justify;
		}

		.botones {
			justify-content: start;
			flex-direction: row;
		}

		.btn-contacto,
		.btn-cv {
			width: 30%;
			font-size: 10px;
			padding: 5px 30px; /* Tamaño uniforme */
		}

		.btn-cv {
			display: block;
		}

		.foto {
			width: 320px;
		}

		.iconos {
			left: 30px;
			bottom: 30px;
			right: auto;
			top: auto;
			transform: none;
			font-size: 30px;
		}

		.info-btn-container {
			width: 500px;
		}

		.sobre-mi-titulos {
			margin-top: 100px;
		}

		.sobre-mi-contenedor {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 60px;
			flex-wrap: wrap;
			margin-top: 40px;
		}

		.sobre-mi-imagen-texto {
			flex-direction: row;
			justify-content: space-around;
		}

		.sobre-mi-imagen-texto p {
			width: 100%;
			font-size: 18px;
		}

		.sobre-mi-imagen-texto img {
			width: 250px;
		}

		.sobre-mi-datos {
			width: 45%;
		}

		.contenedor-sobre-mi-datos {
			display: flex;
			flex-direction: row;
			justify-content: center;
			gap: 20px;
		}

		.contacto-redes {
			margin-top: 100px;
		}

		.contacto-redes a {
			margin-left: 10px;
			display: flex;
			align-items: center;
			font-size: 30px;
			margin-top: 20px;
		}
		.contacto-redes i {
			margin-right: 10px;
			font-size: 50px;
		}

		.contacto-mail-contenedor {
			flex-direction: row;
			gap: 50px;
		}

		.contacto-input-contenedor {
			display: flex;
			flex-direction: column;
			width: 50%;
		}
	}

	@media screen and (min-width: 1250px) {
		.info-btn-container {
			width: 700px;
		}

		.btn-contacto,
		.btn-cv {
			font-size: 16px;
		}

		.section-info * {
			margin-top: 20px;
		}

		.section-info h1 {
			font-size: 50px;
			color: white;
		}

		.foto {
			width: 350px;
		}

		.section-info h5 {
			color: #1abc9c;
		}

		.sobre-mi-datos {
			border: 2px solid #757272;
			border-radius: 30px;
			margin-top: 20px;
			color: black;
			width: 90%;
			max-width: 350px;
		}

		.sobre-mi-imagen-texto p {
			margin-top: 20px;
		}

		.sobre-mi-imagen-texto img {
			margin-top: 20px;
		}

		.sobre-mi-datos span {
			font-size: 50px;
		}

		.sobre-mi-datos h6 {
			font-size: 30px;
		}

		.sobre-mi-datos p {
			font-size: 20px;
		}
		.sobre-mi-contenedor {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 25px;
		}

		.contacto-seccion {
			width: 80%;
		}
		.contacto-titulos h2 {
			font-size: 60px;
		}

		.contacto-mail {
			margin-top: 150px;
		}

		.contacto-mail-contenedor {
			flex-direction: row;
			gap: 50px;
		}

		.contacto-input-contenedor {
			display: flex;
			flex-direction: column; /* Mantiene los inputs en columna */
			width: 50%; /* Hace que los inputs ocupen la mitad del ancho */
		}

		textarea {
			height: 96px;
		}

		button {
			width: 10%;
		}
	}
</style>
