				</a>
				<div class="proyecto-info">
					<h3>Padel Ges</h3>
					<p>{t("projects.parrafo1")}</p>
					<div class="proyecto-tags">
						<span class="tech-tag">Laravel</span>
						<span class="tech-tag">PHP</span>
						<span class="tech-tag">MySQL</span>
					</div>
				</div>
			</div>
			<div class="proyecto-card">
				<a
					class="proyecto-imagen-link"
					href="https://utilidadesonline.es"
					target="_blank"
					rel="noopener noreferrer"
				>
					<img
						class="proyecto-imagen"
						src="/images/utilidadesOnline.png"
						alt="Utilidades Online"
					/>
					<span class="proyecto-overlay">{t("projects.verProyecto")} ↗</span>
				</a>
				<div class="proyecto-info">
					<h3>Utilidades Online</h3>
					<p>{t("projects.parrafo2")}</p>
					<div class="proyecto-tags">
						<span class="tech-tag">Astro</span>
						<span class="tech-tag">TypeScript</span>
						<span class="tech-tag">Tailwind CSS</span>
						<span class="tech-tag">Cloudflare</span>
					</div>
				</div>
			</div>
		</div>
		<div class="skills-bloque reveal">
			<h5>{t("projects.habilidades")}</h5>
			<div class="skills">
				<span class="skill-pill">HTML5</span>
				<span class="skill-pill">CSS3</span>
				<span class="skill-pill">JavaScript</span>
				<span class="skill-pill">TypeScript</span>
				<span class="skill-pill">Astro</span>
				<span class="skill-pill">Laravel</span>
				<span class="skill-pill">PHP</span>
				<span class="skill-pill">MySQL</span>
				<span class="skill-pill">Tailwind CSS</span>
				<span class="skill-pill">Bootstrap</span>
				<span class="skill-pill">Java</span>
			</div>
		</div>
	</div>
</section>
<section class="section-pad" id="contacto">
	<div class="contacto-seccion section-container">
		<div class="contacto-titulos reveal">
			<h2 class="section-title">{t("contacto.contacta")}</h2>
			<h5 class="contacto-idiomas">
				<span>{t("contacto.hablo")}</span>
				<span class="contacto-banderas">
					<img src="/images/spain.png" alt="España" width="24px" />
					<img src="/images/united-kingdom.png" alt="uk" width="24px" />
				</span>
			</h5>
		</div>
		<div class="contacto-grid reveal">
			<a class="contacto-card" href="mailto:sam_po13@hotmail.com">
				<i class="fa-solid fa-envelope"></i>
				<div>
					<h6>{t("contacto.correo")}</h6>
					<p>sam_po13@hotmail.com</p>
				</div>
			</a>
			<a
				class="contacto-card"
				href="https://wa.me/34636731525"
				target="_blank"
				rel="noopener noreferrer"
			>
				<i class="fa-brands fa-whatsapp"></i>
				<div>
					<h6>WhatsApp</h6>
					<p>+34 636 731 525</p>
				</div>
			</a>
			<a
				class="contacto-card"
				href="https://www.linkedin.com/in/sammyodeh"
				target="_blank"
				rel="noopener noreferrer"
			>
				<i class="fa-brands fa-linkedin"></i>
				<div>
					<h6>LinkedIn</h6>
					<p>{t("contacto.linkedin")}</p>
				</div>
			</a>
			<a
				class="contacto-card"
				href="https://github.com/devSammyO"
				target="_blank"
				rel="noopener noreferrer"
			>
				<i class="fa-brands fa-github"></i>
				<div>
					<h6>GitHub</h6>
					<p>{t("contacto.insta")}</p>
				</div>
			</a>
		</div>
	</div>
</section>

<style>
	.material-symbols-outlined {
		color: var(--text);
		font-size: 30px;
	}

	/* ===== Hero ===== */
	.hero-bg {
		position: relative;
		overflow: hidden;
		background: linear-gradient(160deg, #0d1117 0%, #000000 100%);
	}

	.hero-bg::before {
		content: "";
		position: absolute;
		inset: 0;
		background-image: radial-gradient(
			rgba(255, 255, 255, 0.08) 1px,
			transparent 1px
		);
		background-size: 26px 26px;
		pointer-events: none;
	}

	.hero-bg::after {
		content: "";
		position: absolute;
		top: 50%;
		left: 50%;
		width: 700px;
		height: 700px;
		transform: translate(-50%, -50%);
		background: radial-gradient(
			circle,
			rgba(26, 188, 156, 0.25),
			transparent 70%
		);
		pointer-events: none;
	}

	.hero-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		pointer-events: none;
	}

	.contenedor {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 30px;
		text-align: center;
		color: var(--text);
	}

	.scroll-down {
		position: absolute;
		bottom: 28px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 1;
		color: var(--text-dim);
		font-size: 18px;
		animation: scroll-bounce 2s ease-in-out infinite;
		transition: color 0.25s ease;
	}

	.scroll-down:hover {
		color: var(--accent);
	}

	@keyframes scroll-bounce {
		0%,
		100% {
			transform: translate(-50%, 0);
		}
		50% {
			transform: translate(-50%, 8px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-down {
			animation: none;
		}
	}

	.foto {
		width: 150px;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		border-radius: 50%;
		border: 3px solid var(--accent);
		box-shadow: 0 0 0 6px rgba(26, 188, 156, 0.12),
			0px 20px 40px rgba(0, 0, 0, 0.5);
	}

	.section-info {
		margin-top: 0;
	}

	.nombre {
		background: linear-gradient(
			90deg,
			var(--accent),
			#5ee7c8,
			var(--accent)
		);
		background-size: 200% auto;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		animation: gradient-shift 6s ease-in-out infinite;
	}

	@keyframes gradient-shift {
		0% {
			background-position: 0% 50%;
		}
		50% {
			background-position: 100% 50%;
		}
		100% {
			background-position: 0% 50%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.nombre {
			animation: none;
		}
	}

	.section-info * {
		margin-top: 10px;
	}

	.section-info-parrafo {
		display: none;
		color: var(--text-muted);
	}

	.botones {
		display: flex;
		justify-content: center;
		flex-direction: column;
		gap: 10px;
	}

	/* Estilos generales de los botones */
	.btn-contacto,
	.btn-cv {
		padding: 12px 24px;
		min-width: 180px;
		font-size: 16px;
		font-weight: bold;
		border-radius: 5px;
		cursor: pointer;
		transition: all 0.3s ease-in-out;
		text-transform: uppercase;
		box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
		margin-top: 10px;
	}

	/* Botón Contacto */
	.btn-contacto {
		background-color: var(--accent);
		color: black;
		border: 2px solid var(--accent);
		transition: all 0.3s ease-in-out;
	}

	.btn-contacto:focus,
	.btn-cv:focus {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.btn-contacto:hover {
		background-color: transparent;
		color: var(--accent);
		transform: translateY(-2px);
		box-shadow: 0 0 12px rgba(26, 188, 156, 0.4);
	}

	/* Botón Descargar CV */
	.btn-cv {
		color: var(--accent);
		background-color: transparent;
		border: 2px solid var(--accent);
	}

	/* Hover Estandarizado */
	.btn-cv:hover {
		background-color: var(--accent-hover);
		color: black;
		transform: translateY(-2px);
		box-shadow: 0px 8px 15px rgba(0, 0, 0, 0.15);
	}

	/* Efecto al hacer clic */
	.btn-contacto:active,
	.btn-cv:active {
		transform: scale(0.98);
	}

	.iconos {
		position: fixed;
		right: 25px;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		flex-direction: column;
		gap: 20px;
		font-size: 30px;
		z-index: 900;
	}

	.iconos a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--bg-elevated);
		border: 1px solid var(--border-strong);
		color: var(--text);
		font-size: 20px;
		transition: all 0.3s ease;
	}

	.iconos a:hover {
		color: var(--accent);
		border-color: var(--accent);
		transform: scale(1.15);
	}

	/* ===== Sobre mí ===== */
	.sobre-mi-titulos {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.sobre-mi-titulos h5 {
		color: var(--text-muted);
	}

	.sobre-mi-contenedor {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 30px;
	}

	.sobre-mi-foto {
		position: relative;
		width: 220px;
	}

	.sobre-mi-foto::before {
		content: "";
		position: absolute;
		inset: 14px -14px -14px 14px;
		background: var(--accent);
		border-radius: 20px;
		z-index: 0;
	}

	.sobre-mi-foto img {
		position: relative;
		z-index: 1;
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 20px;
		border: 1px solid var(--border-strong);
		box-shadow: 0px 20px 40px rgba(0, 0, 0, 0.5);
	}

	.sobre-mi-contenido {
		display: flex;
		flex-direction: column;
		gap: 25px;
		max-width: 520px;
		text-align: left;
	}

	.sobre-mi-parrafo {
		color: var(--text-muted);
		font-size: 15px;
		line-height: 1.7;
	}

	.sobre-mi-highlights {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.highlight {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.highlight .material-symbols-outlined {
		color: var(--accent);
		font-size: 26px;
		flex-shrink: 0;
	}

	.highlight h6 {
		margin: 0;
		color: var(--text);
		font-size: 15px;
	}

	.highlight p {
		margin: 0;
		color: var(--text-dim);
		font-size: 13px;
	}

	/* ===== Proyectos ===== */
	.proyectos-titulos {
		display: flex;
	}

	.proyectos-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 30px;
		width: 100%;
	}

	.proyecto-card {
		display: flex;
		flex-direction: column;
		text-align: left;
		background: var(--bg-elevated);
		border-radius: 16px;
		overflow: hidden;
		border: 1px solid var(--border);
		box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.35);
		transition: transform 0.3s ease, box-shadow 0.3s ease,
			border-color 0.3s ease;
	}

	.proyecto-card:hover {
		transform: translateY(-6px);
		border-color: var(--accent);
		box-shadow: 0px 16px 40px rgba(0, 0, 0, 0.5);
	}

	.proyecto-imagen-link {
		position: relative;
		display: block;
		aspect-ratio: 16 / 10;
		overflow: hidden;
	}

	.proyecto-imagen {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.proyecto-card:hover .proyecto-imagen {
		transform: scale(1.05);
	}

	.proyecto-overlay {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(0, 0, 0, 0.65);
		color: white;
		font-weight: bold;
		text-transform: uppercase;
		font-size: 14px;
		letter-spacing: 0.5px;
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.proyecto-card:hover .proyecto-overlay {
		opacity: 1;
	}

	.proyecto-info {
		padding: 20px;
	}

	.proyecto-info h3 {
		color: var(--text);
	}

	.proyecto-info p {
		margin-top: 10px;
		color: var(--text-muted);
		font-size: 14px;
	}

	.proyecto-tags {
		margin-top: 15px;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.tech-tag {
		background: var(--accent-soft);
		color: var(--accent);
		font-size: 12px;
		font-weight: bold;
		padding: 4px 10px;
		border-radius: 20px;
	}

	/* ===== Contacto ===== */
	.contacto-titulos {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.contacto-titulos h5 {
		color: var(--text-muted);
	}

	.contacto-idiomas {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.contacto-banderas {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}

	.contacto-banderas img {
		display: inline-block;
	}

	.contacto-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 16px;
		width: 100%;
		max-width: 480px;
	}

	.contacto-card {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 18px 20px;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: 14px;
		box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.35);
		text-align: left;
		transition: transform 0.3s ease, box-shadow 0.3s ease,
			border-color 0.3s ease;
	}

	.contacto-card:hover {
		transform: translateY(-4px);
		border-color: var(--accent);
		box-shadow: 0px 16px 32px rgba(0, 0, 0, 0.5);
	}

	.contacto-card i {
		font-size: 26px;
		color: var(--accent);
		flex-shrink: 0;
		width: 30px;
		text-align: center;
	}

	.contacto-card h6 {
		margin: 0;
		color: var(--text);
		font-size: 15px;
	}

	.contacto-card p {
		margin: 0;
		color: var(--text-muted);
		font-size: 13px;
	}

	button {
		width: 100%;
		margin-top: 20px;
		color: black;
		background-color: var(--accent);
		border-radius: 5px;
		border: none;
		transition: all 0.3s ease-in-out;
		box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
	}

	button:hover {
		background-color: var(--accent-hover);
		transform: scale(1.05);
	}

	@media screen and (min-width: 988px) {
		.contenedor {
			flex-direction: row-reverse;
			align-items: center;
			justify-content: center;
			gap: clamp(40px, 6vw, 100px);
		}

		.section-info {
			text-align: left;
		}

		.section-info-parrafo {
			display: block;
		}

		.botones {
			justify-content: start;
			flex-direction: row;
		}

		.btn-contacto,
		.btn-cv {
			width: 30%;
			font-size: 10px;
			padding: 5px 30px; /* Tamaño uniforme */
		}

		.btn-cv {
			display: block;
		}

		.foto {
			width: 320px;
		}

		.iconos {
			left: 30px;
			bottom: 30px;
			right: auto;
			top: auto;
			transform: none;
			font-size: 30px;
		}

		.info-btn-container {
			width: 500px;
		}

		.sobre-mi-contenedor {
			flex-direction: row;
			align-items: center;
			justify-content: center;
			gap: 70px;
		}

		.sobre-mi-foto {
			width: 280px;
			flex-shrink: 0;
		}

		.sobre-mi-highlights {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 24px 30px;
		}

		.proyectos-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.contacto-grid {
			grid-template-columns: repeat(2, 1fr);
			max-width: 700px;
		}
	}

	@media screen and (min-width: 1250px) {
		.info-btn-container {
			width: 700px;
		}

		.btn-contacto,
		.btn-cv {
			font-size: 16px;
		}

		.section-info * {
