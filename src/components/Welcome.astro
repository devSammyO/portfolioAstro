---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import Security from "./Security.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const skillGroups = [
	{
		icon: "fa-solid fa-server",
		title: t("projects.catSistemasTitulo"),
		items: [
			"Windows Server",
			"Windows",
			"Linux",
			t("projects.catSistemas1"),
			t("projects.catSistemas2"),
			t("projects.catSistemas3"),
			"Microsoft Office",
		],
	},
	{
		icon: "fa-solid fa-code",
		title: t("projects.catBackendTitulo"),
		items: ["Java", "JavaFX", "Bash", "Firebase"],
	},
	{
		icon: "fa-solid fa-laptop-code",
		title: t("projects.catFrontendTitulo"),
		items: [
			"HTML",
			"CSS",
			"JavaScript",
			"jQuery",
			"Bootstrap",
			"SASS",
			"Vue.js",
		],
	},
	{
		icon: "fa-solid fa-database",
		title: t("projects.catDatosTitulo"),
		items: ["MongoDB", "Docker", "Git", "GitHub"],
	},
];
---

<section class="hero-bg section-full" id="inicio">
	<canvas id="heroCanvas" class="hero-canvas" aria-hidden="true"></canvas>
	<div class="contenedor">
		<div>
			<img class="foto" src="/images/sammy.png" alt="Sammy Odeh" />
		</div>
		<div class="info-btn-container">
			<div class="section-info">
				<h3>{t("info.hello")}</h3>
				<h1 class="nombre">Sammy Odeh</h1>
				<h5>{t("info.webDev")}</h5>
				<p class="section-info-parrafo">
					{t("info.parrafo")}
				</p>
			</div>
			<div class="botones">
				<button class="btn btn-ghost btn-cv" data-spotlight>
					<span class="btn-spotlight" aria-hidden="true"></span>
					<span class="btn-content">
						<i class="fa-solid fa-download btn-icon" aria-hidden="true"></i>
						{t("info.cv")}
					</span>
				</button>
				<button class="btn btn-solid btn-contacto" data-spotlight>
					<span class="btn-ping" aria-hidden="true"></span>
					<span class="btn-spotlight" aria-hidden="true"></span>
					<span class="btn-content">
						<i class="fa-solid fa-paper-plane btn-icon" aria-hidden="true"
						></i>
						{t("nav.contact")}
					</span>
				</button>
			</div>
		</div>
		<div class="iconos">
			<a
				href="https://github.com/devSammyO"
				target="_blank"
				rel="noopener noreferrer"
			>
				<i class="fa-brands fa-github"></i>
			</a>
			<a
				href="https://www.linkedin.com/in/sammyodeh"
				target="_blank"
				rel="noopener noreferrer"
			>
				<i class="fa-brands fa-linkedin"></i>
			</a>
		</div>
	</div>
	<a href="#sobre-mi" class="scroll-down" aria-label="Scroll down">
		<i class="fa-solid fa-chevron-down"></i>
	</a>
	<!-- Redes Sociales -->
</section>
<section class="section-pad section-alt about-section" id="sobre-mi">
	<div class="sobre-mi-seccion section-container">
		<div class="sobre-mi-titulos section-head reveal">
			<span class="section-head-index" aria-hidden="true">01</span>
			<div class="section-head-main">
				<span class="section-tag">
					<span class="section-tag-path">~/sobre-mi</span>
					<span class="section-tag-dot" aria-hidden="true"></span>
					{t("about.aprende")}
				</span>
				<h2 class="section-title" data-scramble>{t("about.aboutMe")}</h2>
			</div>
			<p class="section-head-desc">{t("about.subtitulo")}</p>
		</div>
		<div class="about-grid reveal">
			<div class="about-terminal term-window">
				<div class="term-bar">
					<span class="term-dot term-dot-red"></span>
					<span class="term-dot term-dot-yellow"></span>
					<span class="term-dot term-dot-green"></span>
					<span class="term-bar-title">sammy@portfolio: ~</span>
				</div>
				<div class="about-terminal-body">
					<p class="about-terminal-line">
						<span class="about-terminal-prompt">sammy@portfolio</span><span
							class="about-terminal-sep">:~$</span
						> whoami
					</p>
					<p class="about-terminal-output">{t("about.parrafo")}</p>
					<p class="about-terminal-line">
						<span class="about-terminal-prompt">sammy@portfolio</span><span
							class="about-terminal-sep">:~$</span
						>
						<span class="about-terminal-cursor" aria-hidden="true"></span>
					</p>
				</div>
			</div>
			<div class="about-stats">
				<div class="about-stat-card">
					<span class="about-stat-icon material-symbols-outlined"
						>military_tech</span
					>
					<h6>1+ {t("about.años")}</h6>
					<p>{t("about.rol")}</p>
				</div>
				<div class="about-stat-card">
					<span class="about-stat-icon material-symbols-outlined">school</span>
					<h6>{t("about.daw")}</h6>
					<p>{t("about.fp")}</p>
				</div>
				<div class="about-stat-card">
					<span class="about-stat-icon material-symbols-outlined"
						>security</span
					>
					<h6>{t("about.masterCyber")}</h6>
					<p>{t("about.especializacion")}</p>
				</div>
				<div class="about-stat-card">
					<span class="about-stat-icon material-symbols-outlined"
						>location_on</span
					>
					<h6>{t("about.ubicacion")}</h6>
					<p>{t("about.disponibilidad")}</p>
				</div>
			</div>
		</div>
	</div>
</section>
<Security />
<section class="section-pad section-alt" id="proyectos">
	<div class="proyectos-seccion section-container">
		<div class="proyectos-titulos section-head reveal">
			<span class="section-head-index" aria-hidden="true">03</span>
			<div class="section-head-main">
				<span class="section-tag">
					<span class="section-tag-path">~/proyectos</span>
					<span class="section-tag-dot" aria-hidden="true"></span>
					{t("projects.eyebrow")}
				</span>
				<h2 class="section-title" data-scramble>{t("projects.proyectos")}</h2>
			</div>
			<p class="section-head-desc">{t("projects.subtitulo")}</p>
		</div>
		<div class="proyectos-grid reveal">
			<div class="proyecto-card">
				<a
					class="proyecto-imagen-link"
					href="https://padel-web-production-352d.up.railway.app/"
					target="_blank"
					rel="noopener noreferrer"
				>
					<img
						class="proyecto-imagen"
						src="/images/padelGes.png"
						alt="Padel Ges"
					/>
					<span class="proyecto-overlay">
						<span class="btn btn-solid btn-sm" data-spotlight>
							<span class="btn-spotlight" aria-hidden="true"></span>
							<span class="btn-content">
								{t("projects.verProyecto")}
								<i
									class="fa-solid fa-arrow-up-right-from-square btn-icon"
									aria-hidden="true"
								/>
							</span>
						</span>
					</span>
				</a>
				<div class="proyecto-info">
					<h3>Padel Ges</h3>
					<p>{t("projects.parrafo1")}</p>
					<div class="proyecto-demo">
						<span class="proyecto-demo-label">
							<i class="fa-solid fa-key" aria-hidden="true" />
							{t("projects.demoLabel")}
						</span>
						<code class="proyecto-demo-cred">demo@example.com</code>
						<code class="proyecto-demo-cred">password</code>
					</div>
					<p class="proyecto-demo-nota">{t("projects.padelDemoNota")}</p>
					<div class="proyecto-tags">
						<span class="tech-tag">Laravel</span>
						<span class="tech-tag">PHP</span>
						<span class="tech-tag">MySQL</span>
					</div>
				</div>
			</div>
			<div class="proyecto-card">
				<a
					class="proyecto-imagen-link"
					href="https://utilidadesonline.es"
					target="_blank"
					rel="noopener noreferrer"
				>
					<img
						class="proyecto-imagen"
						src="/images/utilidadesOnline.png"
						alt="Utilidades Online"
					/>
					<span class="proyecto-overlay">
						<span class="btn btn-solid btn-sm" data-spotlight>
							<span class="btn-spotlight" aria-hidden="true"></span>
							<span class="btn-content">
								{t("projects.verProyecto")}
								<i
									class="fa-solid fa-arrow-up-right-from-square btn-icon"
									aria-hidden="true"
								/>
							</span>
						</span>
					</span>
				</a>
				<div class="proyecto-info">
					<h3>Utilidades Online</h3>
					<p>{t("projects.parrafo2")}</p>
					<div class="proyecto-tags">
						<span class="tech-tag">Astro</span>
						<span class="tech-tag">TypeScript</span>
						<span class="tech-tag">Tailwind CSS</span>
						<span class="tech-tag">Cloudflare</span>
					</div>
				</div>
			</div>
		</div>
		<div class="skills-bloque reveal">
			<h5 class="term-label">
				<span class="term-label-prompt">$</span>
				<span class="term-label-cmd">ls</span>
				<span class="term-label-path">~/habilidades</span>
				<span class="term-label-cursor" aria-hidden="true"></span>
			</h5>
			<div class="habilidades term-window">
				<div class="term-bar">
					<span class="term-dot term-dot-red"></span>
					<span class="term-dot term-dot-yellow"></span>
					<span class="term-dot term-dot-green"></span>
					<span class="term-bar-title">sammy@dev: ~/habilidades</span>
				</div>
				<div class="habilidades-body skills-matrix">
					{
						skillGroups.map((group) => (
							<details class="skills-panel">
								<summary class="skills-panel-head">
									<span class="skills-panel-icon">
										<i class={group.icon} />
									</span>
									<h6>{group.title}</h6>
									<span class="skills-panel-count">{group.items.length}</span>
									<i
										class="fa-solid fa-chevron-down skills-panel-caret"
										aria-hidden="true"
									/>
								</summary>
								<div class="skills">
									{group.items.map((item) => (
										<span class="skill-pill">{item}</span>
									))}
								</div>
							</details>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>
<section class="section-pad" id="contacto">
	<div class="contacto-seccion section-container">
		<div class="contacto-titulos section-head reveal">
			<span class="section-head-index" aria-hidden="true">04</span>
			<div class="section-head-main">
				<span class="section-tag">
					<span class="section-tag-path">~/contacto</span>
					<span class="section-tag-dot" aria-hidden="true"></span>
					{t("contacto.eyebrow")}
				</span>
				<h2 class="section-title" data-scramble>{t("contacto.contacta")}</h2>
				<h5 class="contacto-idiomas">
					<span>{t("contacto.hablo")}</span>
					<span class="contacto-banderas">
						<img src="/images/spain.png" alt="España" width="24px" />
						<img src="/images/united-kingdom.png" alt="uk" width="24px" />
					</span>
				</h5>
			</div>
			<p class="section-head-desc">{t("contacto.subtitulo")}</p>
		</div>
		<div class="contacto-grid reveal">
			<a
				class="contacto-card"
				href="mailto:sam_po13@hotmail.com"
				data-spotlight
			>
				<span class="btn-spotlight" aria-hidden="true"></span>
				<i class="fa-solid fa-envelope"></i>
				<div>
					<h6>{t("contacto.correo")}</h6>
					<p>sam_po13@hotmail.com</p>
				</div>
			</a>
			<a
				class="contacto-card"
				href="https://wa.me/34636731525"
				target="_blank"
				rel="noopener noreferrer"
				data-spotlight
			>
				<span class="btn-spotlight" aria-hidden="true"></span>
				<i class="fa-brands fa-whatsapp"></i>
				<div>
					<h6>WhatsApp</h6>
					<p>+34 636 731 525</p>
				</div>
			</a>
			<a
				class="contacto-card"
				href="https://www.linkedin.com/in/sammyodeh"
				target="_blank"
				rel="noopener noreferrer"
				data-spotlight
			>
				<span class="btn-spotlight" aria-hidden="true"></span>
				<i class="fa-brands fa-linkedin"></i>
				<div>
					<h6>LinkedIn</h6>
					<p>{t("contacto.linkedin")}</p>
				</div>
			</a>
			<a
				class="contacto-card"
				href="https://github.com/devSammyO"
				target="_blank"
				rel="noopener noreferrer"
				data-spotlight
			>
				<span class="btn-spotlight" aria-hidden="true"></span>
				<i class="fa-brands fa-github"></i>
				<div>
					<h6>GitHub</h6>
					<p>{t("contacto.insta")}</p>
				</div>
			</a>
		</div>
	</div>
</section>

<style>
	.material-symbols-outlined {
		color: var(--text);
		font-size: 30px;
	}

	/* ===== Habilidades (terminal window, igual que el Arsenal) ===== */
	.habilidades {
		width: 100%;
	}

	.habilidades-body {
		padding: 24px;
	}

	/* ===== Hero ===== */
	.hero-bg {
		position: relative;
		z-index: 0;
		overflow: hidden;
		background: linear-gradient(160deg, #0d1117 0%, #000000 100%);
	}

	.hero-bg::after {
		content: "";
		position: absolute;
		top: 50%;
		left: 50%;
		width: 700px;
		height: 700px;
		transform: translate(-50%, -50%);
		background: radial-gradient(
			circle,
			rgba(26, 188, 156, 0.25),
			transparent 70%
		);
		pointer-events: none;
	}

	.hero-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		pointer-events: none;
		z-index: 0;
	}

	.contenedor {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 30px;
		text-align: center;
		color: var(--text);
	}

	.scroll-down {
		position: absolute;
		bottom: 28px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 1;
		color: var(--text-dim);
		font-size: 18px;
		animation: scroll-bounce 2s ease-in-out infinite;
		transition: color 0.25s ease;
	}

	.scroll-down:hover {
		color: var(--accent);
	}

	@keyframes scroll-bounce {
		0%,
		100% {
			transform: translate(-50%, 0);
		}
		50% {
			transform: translate(-50%, 8px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-down {
			animation: none;
		}
	}

	.foto {
		position: relative;
		z-index: 1;
		width: 150px;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		border-radius: 50%;
		background: var(--bg-alt);
		border: 3px solid var(--accent);
		box-shadow: 0 0 0 6px rgba(26, 188, 156, 0.12),
			0px 20px 40px rgba(0, 0, 0, 0.5);
	}

	.section-info {
		margin-top: 0;
	}

	.nombre {
		background: linear-gradient(
			90deg,
			var(--accent),
			#5ee7c8,
			var(--accent)
		);
		background-size: 200% auto;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		animation: gradient-shift 6s ease-in-out infinite;
	}

	@keyframes gradient-shift {
		0% {
			background-position: 0% 50%;
		}
		50% {
			background-position: 100% 50%;
		}
		100% {
			background-position: 0% 50%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.nombre {
			animation: none;
		}
	}

	.section-info * {
		margin-top: 10px;
	}

	.section-info-parrafo {
		display: none;
		color: var(--text-muted);
	}

	.botones {
		display: flex;
		justify-content: center;
		flex-direction: column;
		gap: 14px;
		margin-top: 10px;
	}

	.iconos {
		position: fixed;
		right: 25px;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		flex-direction: column;
		gap: 20px;
		font-size: 30px;
		z-index: 900;
	}

	.iconos a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--bg-elevated);
		border: 1px solid var(--border-strong);
		color: var(--text);
		font-size: 20px;
		transition: all 0.3s ease;
	}

	.iconos a:hover {
		color: var(--accent);
		border-color: var(--accent);
		transform: scale(1.15);
	}

	/* ===== Sobre mí ===== */
	.about-section {
		position: relative;
		overflow: hidden;
	}

	.about-section::before {
		content: "";
		position: absolute;
		top: -120px;
		right: -120px;
		width: 420px;
		height: 420px;
		background: radial-gradient(
			circle,
			rgba(26, 188, 156, 0.14),
			transparent 70%
		);
		pointer-events: none;
	}

	.about-grid {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: 24px;
		width: 100%;
		text-align: left;
	}

	.about-terminal-body {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 24px 22px;
	}

	.about-terminal-line {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 6px;
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--text-muted);
	}

	.about-terminal-prompt {
		color: var(--accent);
		font-weight: 600;
	}

	.about-terminal-sep {
		color: var(--text-dim);
	}

	.about-terminal-cursor {
		display: inline-block;
		width: 7px;
		height: 14px;
		background: var(--accent);
		vertical-align: middle;
		animation: about-blink 1s steps(1) infinite;
	}

	@keyframes about-blink {
		50% {
			opacity: 0;
		}
	}

	.about-terminal-output {
		margin-left: 2px;
		padding-left: 16px;
		border-left: 2px solid var(--border);
		color: var(--text);
		font-size: 15px;
		line-height: 1.7;
	}

	@media (prefers-reduced-motion: reduce) {
		.about-terminal-cursor {
			animation: none;
		}
	}

	/* --- Tarjetas de highlights --- */
	.about-stats {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 14px;
	}

	.about-stat-card {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 20px;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: 14px;
		box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.3);
		transition: transform 0.3s ease, border-color 0.3s ease,
			box-shadow 0.3s ease;
	}

	.about-stat-card:hover {
		transform: translateY(-4px);
		border-color: var(--accent);
		box-shadow: 0px 16px 32px rgba(0, 0, 0, 0.45);
	}

	.about-stat-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 10px;
		background: var(--accent-soft);
		color: var(--accent) !important;
		font-size: 22px !important;
	}

	.about-stat-card h6 {
		margin: 0;
		color: var(--text);
		font-size: 15px;
	}

	.about-stat-card p {
		margin: 0;
		color: var(--text-dim);
		font-size: 13px;
	}

	/* ===== Proyectos ===== */
	.proyectos-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 30px;
		width: 100%;
	}

	.proyecto-card {
		display: flex;
		flex-direction: column;
		text-align: left;
		background: var(--bg-elevated);
		border-radius: 16px;
		overflow: hidden;
		border: 1px solid var(--border);
		box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.35);
		transition: transform 0.3s ease, box-shadow 0.3s ease,
			border-color 0.3s ease;
	}

	.proyecto-card:hover {
		transform: translateY(-6px);
		border-color: var(--accent);
		box-shadow: 0px 16px 40px rgba(0, 0, 0, 0.5);
	}

	.proyecto-imagen-link {
		position: relative;
		display: block;
		aspect-ratio: 16 / 10;
		overflow: hidden;
	}

	.proyecto-imagen {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.proyecto-card:hover .proyecto-imagen {
		transform: scale(1.05);
