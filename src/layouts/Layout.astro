---
import { getLangFromUrl, useTranslations} from '../i18n/utils';

import LanguagePicker from '../components/LanguagePicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---


<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
		/>
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
		/>
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400..700&family=Inter:wght@400;500;600;700&display=swap"
		/>

		<meta name="generator" content={Astro.generator} />
		<title>Sammy Odeh | {t("about.rol")}</title>
		<meta name="description" content={t("info.parrafo")} />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={`Sammy Odeh | ${t("about.rol")}`} />
		<meta property="og:description" content={t("info.parrafo")} />
		<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
		<meta property="og:image" content={new URL("/images/sammy.png", Astro.site)} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={`Sammy Odeh | ${t("about.rol")}`} />
		<meta name="twitter:description" content={t("info.parrafo")} />
		<meta name="twitter:image" content={new URL("/images/sammy.png", Astro.site)} />
	</head>
	<body>
		<!-- Header -->
		<header class="site-header">
			<div class="nav-container">
				<a class="nav-brand" href="/#inicio">Sammy<span>.</span>Odeh</a>

				<button
					class="nav-toggle"
					id="navToggle"
					type="button"
					aria-label="Menu"
					aria-expanded="false"
					aria-controls="navMenu"
				>
					<i class="fa-solid fa-bars"></i>
				</button>

				<nav class="nav-menu" id="navMenu">
					<a class="nav-link" href='/#inicio'>{t('nav.home')}</a>
					<a class="nav-link" href="#sobre-mi">{t('nav.about')}</a>
					<a class="nav-link" href="#proyectos">{t('nav.projects')}</a>
					<a class="nav-link" href="#contacto">{t('nav.contact')}</a>
					<LanguagePicker />
				</nav>
			</div>
		</header>

		<!-- Contenido de la página -->
		<main>
			<slot />
		</main>

		<footer class="footer-site">
			<p>&copy; {new Date().getFullYear()} Sammy Odeh. {t("footer.derechos")}</p>
		</footer>

		<script
			src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.0/dist/sweetalert2.all.min.js" defer
		></script>
		<script src="/js/contacto.js" defer></script>
		<script src="/js/descargarCv.js" defer></script>
		<script src="/js/scrollspy.js" defer></script>
		<script src="/js/navToggle.js" defer></script>
	</body>
</html>

<style is:global>
	:root {
		--bg: #05070a;
		--bg-alt: #0b0e13;
		--bg-elevated: #10141b;
		--border: rgba(255, 255, 255, 0.08);
		--border-strong: rgba(255, 255, 255, 0.16);
		--text: #f2f4f7;
		--text-muted: #9aa4b2;
		--text-dim: #6b7280;
		--accent: #1abc9c;
		--accent-hover: #16a085;
		--accent-soft: rgba(26, 188, 156, 0.12);
		--container-width: 1100px;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background: var(--bg);
		color: var(--text);
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6,
	p,
	ul,
	ol {
		margin: 0;
		padding: 0;
	}

	ul,
	ol {
		list-style: none;
	}

	img {
		max-width: 100%;
		display: block;
	}

	button {
		font-family: inherit;
		font-size: inherit;
		border: none;
		background: none;
		cursor: pointer;
	}

	html {
		scroll-behavior: smooth;
		scroll-padding-top: 90px;
	}

	body {
		font-family: "Inter", sans-serif;
	}

	h1,
	h2,
	h3,
	h5,
	h6 {
		font-family: "Space Grotesk", sans-serif;
	}

	a {
		text-decoration: none;
		color: inherit;
	}
</style>

<style>
	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		z-index: 1000;
		background: rgba(5, 7, 10, 0.75);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}

	.nav-container {
		max-width: var(--container-width);
		margin: 0 auto;
		padding: 16px 24px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.nav-brand {
		font-family: "Space Grotesk", sans-serif;
		font-size: 20px;
		font-weight: 700;
		color: var(--text);
	}

	.nav-brand span {
		color: var(--accent);
	}

	.nav-toggle {
		display: block;
		background: none;
		border: none;
		color: var(--text);
		font-size: 22px;
		cursor: pointer;
		padding: 4px;
	}

	.nav-menu {
		position: fixed;
		top: 65px;
		left: 0;
		width: 100%;
		background: rgba(5, 7, 10, 0.97);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: 10px 24px 24px;
		gap: 4px;
		transform: translateY(-8px);
		opacity: 0;
		pointer-events: none;
		transition: transform 0.25s ease, opacity 0.25s ease;
	}

	.nav-menu.open {
		transform: translateY(0);
		opacity: 1;
		pointer-events: auto;
	}

	.nav-link {
		position: relative;
		display: inline-block;
		padding: 10px 0;
		color: var(--text-muted);
		font-size: 15px;
		font-weight: 500;
		width: fit-content;
	}

	.nav-link::after {
		content: "";
		position: absolute;
		width: 0;
		height: 2px;
		bottom: 4px;
		left: 0;
		background-color: var(--accent);
		transition: width 0.3s ease;
	}

	.nav-link:hover::after,
	.nav-link.active::after {
		width: 100%;
	}

	.nav-link:hover,
	.nav-link.active {
		color: var(--accent);
	}

	.footer-site {
		background-color: var(--bg);
		border-top: 1px solid var(--border);
		text-align: center;
		padding: 24px;
		font-size: 14px;
	}

	.footer-site p {
		margin: 0;
		color: var(--text-dim);
	}

	@media screen and (min-width: 900px) {
		.nav-toggle {
			display: none;
		}

		.nav-menu {
			position: static;
			flex-direction: row;
			align-items: center;
			width: auto;
			gap: 32px;
			background: none;
			border: none;
			padding: 0;
			backdrop-filter: none;
			transform: none;
			opacity: 1;
			pointer-events: auto;
		}
	}
</style>
