---
import { getLangFromUrl, useTranslations} from '../i18n/utils';

import LanguagePicker from '../components/LanguagePicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---


<!doctype html>
<html lang={lang}>
	<head>
		<script is:inline>
			document.documentElement.classList.add("is-loading");
		</script>
		<noscript>
			<style>
				.preloader {
					display: none !important;
				}
				html.is-loading,
				html.is-loading body {
					overflow: auto !important;
					height: auto !important;
				}
			</style>
		</noscript>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
		/>
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
		/>
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400..700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
		/>

		<meta name="generator" content={Astro.generator} />
		<title>Sammy Odeh | {t("about.rol")}</title>
		<meta name="description" content={t("info.parrafo")} />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={`Sammy Odeh | ${t("about.rol")}`} />
		<meta property="og:description" content={t("info.parrafo")} />
		<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
		<meta property="og:image" content={new URL("/images/sammy.png", Astro.site)} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={`Sammy Odeh | ${t("about.rol")}`} />
		<meta name="twitter:description" content={t("info.parrafo")} />
		<meta name="twitter:image" content={new URL("/images/sammy.png", Astro.site)} />
	</head>
	<body>
		<!-- Preloader -->
		<div class="preloader" id="preloader" role="status" aria-label="Loading">
			<div class="preloader-scan" aria-hidden="true"></div>
			<div class="preloader-box">
				<p class="preloader-log">
					<span class="preloader-prompt">&gt;</span> {t('preloader.boot')}<span class="preloader-cursor"></span>
				</p>
				<p class="preloader-log preloader-log-dim">
					<span class="preloader-prompt">&gt;</span> {t('preloader.whoami')}
				</p>
				<h2 class="preloader-name" id="preloaderName" data-text="SAMMY ODEH" aria-hidden="true"></h2>
				<div class="preloader-progress" aria-hidden="true">
					<span class="preloader-progress-fill" id="preloaderFill"></span>
				</div>
				<p
					class="preloader-status"
					id="preloaderStatus"
					aria-hidden="true"
					data-messages={JSON.stringify([
						t('preloader.status1'),
						t('preloader.status2'),
						t('preloader.status3'),
						t('preloader.status4'),
					])}
				></p>
			</div>
		</div>

		<!-- Header -->
		<header class="site-header" id="siteHeader">
			<div class="nav-container">
				<a class="nav-brand" href="/#inicio">
					<span class="status-dot" role="img" aria-label={t('nav.disponible')} title={t('nav.disponible')}></span>
					Sammy<span>.</span>Odeh
				</a>

				<button
					class="nav-toggle"
					id="navToggle"
					type="button"
					aria-label="Menu"
					aria-expanded="false"
					aria-controls="navMenu"
				>
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
				</button>

				<div class="nav-menu" id="navMenu">
					<nav class="nav-links">
						<span class="nav-pill" id="navPill" aria-hidden="true"></span>
						<a class="nav-link" href='/#inicio'>{t('nav.home')}</a>
						<a class="nav-link" href="#sobre-mi">{t('nav.about')}</a>
						<a class="nav-link" href="#seguridad">{t('nav.security')}</a>
						<a class="nav-link" href="#proyectos">{t('nav.projects')}</a>
						<a class="nav-link" href="#contacto">{t('nav.contact')}</a>
					</nav>
					<div class="nav-lang">
						<LanguagePicker />
					</div>
				</div>
			</div>
		</header>

		<!-- Contenido de la página -->
		<main>
			<slot />
		</main>

		<footer class="footer-site">
			<p>&copy; {new Date().getFullYear()} Sammy Odeh. {t("footer.derechos")}</p>
		</footer>

		<script
			src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.0/dist/sweetalert2.all.min.js" defer
		></script>
		<script src="/js/contacto.js" defer></script>
		<script src="/js/descargarCv.js" defer></script>
		<script src="/js/scrollspy.js" defer></script>
		<script src="/js/navToggle.js" defer></script>
		<script src="/js/reveal.js" defer></script>
		<script src="/js/navPill.js" defer></script>
		<script src="/js/headerScroll.js" defer></script>
		<script src="/js/titleScramble.js" defer></script>
		<script src="/js/btnSpotlight.js" defer></script>
		<script src="/js/preloader.js" defer></script>
		<script src="/js/heroNetwork.js" defer></script>
	</body>
</html>

<style is:global>
	:root {
		--bg: #05070a;
		--bg-alt: #0b0e13;
		--bg-elevated: #10141b;
		--border: rgba(255, 255, 255, 0.08);
		--border-strong: rgba(255, 255, 255, 0.16);
		--text: #f2f4f7;
		--text-muted: #9aa4b2;
		--text-dim: #6b7280;
		--accent: #1abc9c;
		--accent-hover: #16a085;
		--accent-soft: rgba(26, 188, 156, 0.12);
		--container-width: 1100px;
		--font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo,
			Consolas, monospace;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	.reveal {
		opacity: 0;
		transform: translateY(24px);
		transition: opacity 0.6s ease, transform 0.6s ease;
	}

	.reveal.in-view {
		opacity: 1;
		transform: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}

	html.is-loading,
	html.is-loading body {
		overflow: hidden;
		height: 100%;
	}

	/* ===== Preloader ===== */
	.preloader {
		position: fixed;
		inset: 0;
		z-index: 2000;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--bg);
		overflow: hidden;
		transition: opacity 0.5s ease, visibility 0.5s ease;
	}

	.preloader.preloader-hide {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.preloader-scan {
		position: absolute;
		inset: -10% 0;
		background: repeating-linear-gradient(
			to bottom,
			rgba(26, 188, 156, 0.05) 0px,
			rgba(26, 188, 156, 0.05) 1px,
			transparent 1px,
			transparent 3px
		);
		animation: preloader-scan-move 6s linear infinite;
		pointer-events: none;
	}

	@keyframes preloader-scan-move {
		0% {
			transform: translateY(0);
		}
		100% {
			transform: translateY(30px);
		}
	}

	.preloader-box {
		position: relative;
		z-index: 1;
		width: 90%;
		max-width: 420px;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		color: var(--text-dim);
	}

	.preloader-log {
		margin: 0 0 6px;
		font-size: 13px;
		letter-spacing: 0.02em;
	}

	.preloader-log-dim {
		opacity: 0.6;
	}

	.preloader-prompt {
		color: var(--accent);
		margin-right: 6px;
	}

	.preloader-cursor {
		display: inline-block;
		width: 7px;
		height: 14px;
		margin-left: 4px;
		background: var(--accent);
		vertical-align: middle;
		animation: preloader-blink 1s steps(1) infinite;
	}

	@keyframes preloader-blink {
		50% {
			opacity: 0;
		}
	}

	.preloader-name {
		margin: 18px 0 22px;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: clamp(28px, 7vw, 42px);
		font-weight: 700;
		letter-spacing: 0.03em;
		color: var(--text);
		text-shadow: 0 0 24px rgba(26, 188, 156, 0.35);
		min-height: 1.2em;
	}

	.preloader-progress {
		width: 100%;
		height: 3px;
		border-radius: 3px;
		background: var(--border);
		overflow: hidden;
	}

	.preloader-progress-fill {
		display: block;
		height: 100%;
		width: 0%;
		background: linear-gradient(90deg, var(--accent), #5ee7c8);
		transition: width 3s linear;
	}

	.preloader-status {
		margin: 12px 0 0;
		font-size: 12px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--text-dim);
	}

	@media (prefers-reduced-motion: reduce) {
		.preloader-scan {
			animation: none;
		}
		.preloader-cursor {
			animation: none;
		}
		.preloader-progress-fill {
			transition: none;
		}
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background: var(--bg);
		color: var(--text);
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6,
	p,
	ul,
	ol {
		margin: 0;
		padding: 0;
	}

	ul,
	ol {
		list-style: none;
	}

	img {
		max-width: 100%;
		display: block;
	}

	button {
		font-family: inherit;
		font-size: inherit;
		border: none;
		background: none;
		cursor: pointer;
	}

	html {
		scroll-behavior: smooth;
		scroll-padding-top: 24px;
	}

	body {
		font-family: "Inter", sans-serif;
	}

	h1,
	h2,
	h3,
	h5,
	h6 {
		font-family: "Space Grotesk", sans-serif;
	}

	a {
		text-decoration: none;
		color: inherit;
	}

	/* ===== Estructura compartida de secciones ===== */
	.section-full {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 110px 24px 60px;
	}

	.section-pad {
		text-align: center;
		padding: 84px 24px 90px;
	}

	@media screen and (max-width: 899px) {
		.section-pad {
			padding-top: 60px;
		}
	}

	.section-alt {
		background: var(--bg-alt);
	}

	.section-container {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 90%;
		max-width: 1100px;
		margin: 0 auto;
		gap: 44px;
	}

	/* ===== Cabeceras de sección ===== */
	.section-tag {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 7px 16px 7px 14px;
		border: 1px solid var(--border-strong);
		border-radius: 999px;
		background: var(--bg-elevated);
		color: var(--text-muted);
		font-size: 13px;
		font-weight: 500;
	}

	.section-tag-path {
		font-family: var(--font-mono);
		color: var(--accent);
		font-size: 12px;
	}

	/* ===== Ventana de terminal reutilizable ===== */
	.term-window {
		background: var(--bg-elevated);
		border: 1px solid var(--border-strong);
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0px 20px 40px rgba(0, 0, 0, 0.4);
	}

	.term-bar {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 14px 18px;
		background: rgba(255, 255, 255, 0.03);
		border-bottom: 1px solid var(--border);
	}

	.term-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		flex-shrink: 0;
	}

	.term-dot-red {
		background: #ff5f56;
	}

	.term-dot-yellow {
		background: #ffbd2e;
	}

	.term-dot-green {
		background: #27c93f;
	}

	.term-bar-title {
		margin-left: auto;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.03em;
		color: var(--text-dim);
		display: flex;
		align-items: center;
		gap: 6px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.section-tag-dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--text-dim);
		flex-shrink: 0;
	}

	.section-title {
		position: relative;
		display: inline-block;
		color: var(--text);
		font-size: 30px;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}

	/* ===== Cabecera de sección (eyebrow + título + índice + descripción) ===== */
	.section-head {
		position: relative;
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		text-align: left;
		gap: 18px;
	}

	.section-head-index {
		position: absolute;
		top: -0.5em;
		right: 0;
		z-index: 0;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: clamp(46px, 9vw, 88px);
		line-height: 1;
		color: var(--text);
		opacity: 0.05;
		pointer-events: none;
		user-select: none;
	}

	.section-head-main {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.section-head-desc {
		position: relative;
		z-index: 1;
		margin: 0;
		max-width: 480px;
		color: var(--text-muted);
		font-size: 15px;
		line-height: 1.7;
	}

	@media screen and (min-width: 900px) {
		.section-head {
			flex-direction: row;
			align-items: flex-end;
			justify-content: space-between;
			gap: 40px;
		}

		.section-head-desc {
			padding-bottom: 6px;
			text-align: left;
		}
	}

	/* ===== Pills de habilidades compartidas ===== */
	.skills-bloque {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
		width: 100%;
	}

	/* ===== Etiqueta de sub-bloque estilo terminal (reutilizable) ===== */
	.term-label {
		display: inline-flex;
		align-items: baseline;
		gap: 8px;
		font-family: var(--font-mono);
		font-size: 15px;
		font-weight: 600;
	}

	.term-label-prompt {
		color: var(--accent);
	}

	.term-label-cmd {
		color: var(--text-muted);
	}

	.term-label-path {
		color: var(--text);
	}

	.term-label-cursor {
		display: inline-block;
		width: 7px;
		height: 15px;
		background: var(--accent);
		vertical-align: middle;
		animation: term-label-blink 1s steps(1) infinite;
	}

	@keyframes term-label-blink {
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.term-label-cursor {
			animation: none;
		}
	}

	.skills {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		justify-content: center;
	}

	.skill-pill {
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 600;
		padding: 8px 18px;
		border-radius: 20px;
		transition: transform 0.25s ease, border-color 0.25s ease,
			color 0.25s ease;
	}

	.skill-pill:hover {
		transform: translateY(-3px);
		border-color: var(--accent);
		color: var(--accent);
	}

	.tech-tag {
		background: var(--accent-soft);
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 600;
		padding: 4px 10px;
		border-radius: 20px;
	}

	/* ===== Matriz de habilidades por categorías (reutilizable) ===== */
	.skills-matrix {
		display: grid;
		grid-template-columns: 1fr;
		gap: 18px;
		width: 100%;
	}

	.skills-panel {
		border: 1px solid var(--border);
		border-radius: 14px;
		background: rgba(255, 255, 255, 0.02);
		text-align: left;
		transition: border-color 0.3s ease, transform 0.3s ease;
	}

	.skills-panel:hover {
		border-color: var(--accent);
	}

	.skills-panel-head {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 16px 18px;
	}

	summary.skills-panel-head {
		cursor: pointer;
		list-style: none;
	}

	summary.skills-panel-head::-webkit-details-marker {
		display: none;
	}

	.skills-panel-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		flex-shrink: 0;
		border-radius: 10px;
		background: var(--accent-soft);
		color: var(--accent);
		font-size: 14px;
	}

	.skills-panel-head h6 {
		margin: 0;
		color: var(--text);
		font-size: 15px;
	}

	.skills-panel-count {
		color: var(--text-dim);
		font-family: var(--font-mono);
		font-size: 12px;
	}

	.skills-panel-caret {
		margin-left: auto;
		color: var(--text-dim);
		font-size: 13px;
		transition: transform 0.25s ease;
	}

	.skills-panel[open] .skills-panel-caret {
		transform: rotate(180deg);
	}

	.skills-panel[open] {
		border-color: var(--accent);
	}

	.skills-panel .skills {
		justify-content: flex-start;
		padding: 0 18px 18px;
	}

	@media screen and (min-width: 700px) {
		.skills-matrix {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	/* ===== Botones CTA (reutilizable) ===== */
	.btn {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		isolation: isolate;
		overflow: hidden;
		padding: 15px 30px;
		min-width: 210px;
		border-radius: 12px;
		border: 2px solid transparent;
		font-family: "Space Grotesk", sans-serif;
		font-size: 15px;
		font-weight: 600;
		letter-spacing: 0.01em;
		cursor: pointer;
		transition: transform 0.25s ease, box-shadow 0.3s ease,
			border-color 0.3s ease, background-color 0.3s ease,
			color 0.3s ease;
	}

	.btn:hover {
		transform: translateY(-3px);
	}

	.btn:active {
		transform: translateY(-1px) scale(0.97);
	}

	.btn:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.btn-content {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		gap: 10px;
	}

	.btn-icon {
		font-size: 14px;
	}

	/* Mancha de luz que sigue al cursor */
	.btn-spotlight {
		position: absolute;
		inset: 0;
		z-index: 0;
		opacity: 0;
		background: radial-gradient(
			160px circle at var(--x, 50%) var(--y, 50%),
			rgba(255, 255, 255, 0.3),
			transparent 70%
		);
		transition: opacity 0.35s ease;
		pointer-events: none;
	}

	[data-spotlight]:hover .btn-spotlight,
	[data-spotlight]:focus-visible .btn-spotlight {
		opacity: 1;
	}

	/* Variante sólida (primaria) */
	.btn-solid {
		background-color: var(--accent);
		color: #04231c;
		border-color: var(--accent);
		box-shadow: 0px 10px 26px rgba(26, 188, 156, 0.3);
	}

	.btn-solid:hover {
		background-color: var(--accent);
		box-shadow: 0px 16px 36px rgba(26, 188, 156, 0.45);
	}

	.btn-solid .btn-spotlight {
		background: radial-gradient(
			160px circle at var(--x, 50%) var(--y, 50%),
			rgba(255, 255, 255, 0.4),
			transparent 70%
		);
	}

	/* Anillo de pulso opcional, hace eco al status-dot del header */
	.btn-ping {
		position: absolute;
		inset: -2px;
		z-index: -1;
		border-radius: inherit;
		border: 2px solid var(--accent);
		opacity: 0;
